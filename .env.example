# ============================================
# ARTÉVA Maison — backend environment
#
# Copy to `.env` and fill in real values.
# IMPORTANT: save this file as UTF-8 without a BOM. A UTF-16 fragment was once
# appended to the live .env, which silently broke every variable after that
# point (dotenv reads the file as UTF-8, so the keys parsed as garbage).
# ============================================

PORT=5000
NODE_ENV=production

# ── Database ──
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/arteva

# ── URLs ──
# FRONTEND_URL is used to build payment return links, so it must be the origin
# serving the React SPA (no trailing slash).
FRONTEND_URL=https://www.artevamaisonkw.com
BACKEND_URL=https://arteva-maison-backend-gy1x.onrender.com

# ── Auth ──
# One secret signs everything: access tokens, refresh tokens, the revenue
# unlock and the revenue reset ticket. Rotating it signs everybody out, which
# is the intended emergency lever.
JWT_SECRET=generate-a-long-random-string

# How long an ACCESS token lasts. Deliberately short — an expired one is
# renewed silently from the refresh token, so a low value here costs the user
# nothing and limits how long a leaked token is useful. Do not raise this to
# "fix" unexpected logouts; that hides the cause and widens the exposure.
JWT_ACCESS_EXPIRES_IN=2h

# How long a REFRESH token — and so a signed-in session — can live before the
# user has to enter their password again. Refresh tokens are stored hashed on
# the user record and rotate on every use, so this is revocable at any time.
JWT_REFRESH_EXPIRES_DAYS=30

# Superseded by the two settings above. Left documented because tokens minted
# under it are still accepted until they expire; it is no longer read.
# JWT_EXPIRES_IN=30d

# ── MyFatoorah (KNET, cards, Apple Pay) ──
# Dashboard → Integration → API Key. This is a JWT: several hundred characters.
# Anything shorter than 40 chars is treated as unconfigured, and checkout will
# fall back to cash on delivery with PAYMENT_GATEWAY_UNAVAILABLE.
MYFATOORAH_API_KEY=
MYFATOORAH_MODE=test          # test | live
MYFATOORAH_TIMEOUT_MS=15000

# ── Deema BNPL (separate credentials) ──
DEEMA_API_KEY=
DEEMA_WIDGET_KEY=
DEEMA_MODE=test               # test | live

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=ARTEVA Maison <orders@artevamaisonkw.com>

# Where mail addressed to "the owner" goes. Both are optional: with neither
# set, the address on the account holding the `owner` role is used, so changing
# the owner's email in the dashboard is enough to redirect it.
#   OWNER_EMAIL   — overrides the owner lookup everywhere (staging, shared inbox)
#   CONTACT_EMAIL — contact-form messages only, if they should not go to the owner
OWNER_EMAIL=
CONTACT_EMAIL=

# ── Cloudinary (product imagery) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Receipt printer ──
PRINTER_IPP_URL=

# ── WhatsApp Cloud API ────────────────────────────────────────────────────
# Full walkthrough: docs/WHATSAPP_SETUP.md
# Nothing below is optional except where marked. The server prints exactly
# which of these are missing at boot.

# Permanent System User token (Business Manager > System Users).
# NOT the 24-hour token from the API Setup page — that one expires overnight.
WHATSAPP_ACCESS_TOKEN=

# WhatsApp > API Setup > "Phone number ID". A long number.
# This is NOT the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp > API Setup > "WhatsApp Business Account ID".
# Optional for messaging; required for template management APIs.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Any random string you invent. Must match the "Verify token" you type into
# the Meta dashboard when configuring the webhook.
WHATSAPP_VERIFY_TOKEN=

# App dashboard > Settings > Basic > App secret.
# This is what proves an inbound webhook genuinely came from Meta. Without it
# the webhook refuses every request in production, by design: anyone who
# learned the URL could otherwise forge customer messages.
# (META_APP_SECRET is accepted as an alias — it was the original name.)
WHATSAPP_APP_SECRET=

# Graph API endpoint. Defaults are correct; override only to pin a version.
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0

# Where Meta should send webhooks. Used by the setup docs and the health
# report; it does not change routing.
PUBLIC_WEBHOOK_URL=https://your-domain.com/api/meta/whatsapp

# Owner/admin numbers that receive new-order alerts. Comma separated,
# international format, no plus.
WHATSAPP_OWNER_PHONE=96500000000,96500000001

# ── WhatsApp behaviour (all optional) ──
# Transport tuning.
WHATSAPP_TIMEOUT_MS=15000
WHATSAPP_MEDIA_TIMEOUT_MS=30000
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_BACKOFF_MS=1000

# Ceilings we enforce before Meta's own, so a runaway script trips ours first.
WHATSAPP_SEND_RATE_LIMIT=30
WHATSAPP_WEBHOOK_RATE_LIMIT=600

# Inbound handling.
WHATSAPP_AUTO_GREET=true
WHATSAPP_GREET_COOLDOWN_HOURS=2
WHATSAPP_FORWARD_INBOUND=true
WHATSAPP_AI_REPLIES=true
WHATSAPP_ESCALATION_COOLDOWN_HOURS=2

# Route failed Cloud API sends to the Raspberry Pi Baileys agent.
# Leave false unless that agent is verified working — a broken Baileys session
# reports success while every recipient sees "Waiting for this message".
WHATSAPP_PI_FALLBACK=false

# File the templates with Meta at start-up, then remove this flag. Does the
# same work as POST /api/whatsapp/templates/provision, for when nobody can
# hold an admin session and the Meta account at the same time. Idempotent:
# a restart never files a second copy. Needs the access token to carry the
# whatsapp_business_management permission.
# WHATSAPP_PROVISION_TEMPLATES=true
# WHATSAPP_PROVISION_DRY_RUN=true   # report only, submit nothing

# Approved template names, per notification type. Free-form text only reaches
# a customer within 24 hours of THEIR last message; outside that window Meta
# delivers approved templates only. Leave unset to keep sending free-form.
#
# Set these ONLY once GET /api/whatsapp/templates reports them APPROVED.
# Naming a template Meta has not approved makes every send of that type fail
# with 132001 — worse than free-form, which at least works inside 24 hours.
# WHATSAPP_TEMPLATE_CUSTOMER_NEW_ORDER=arteva_order_confirmed
# WHATSAPP_TEMPLATE_STATUS_UPDATE=arteva_order_status
# WHATSAPP_TEMPLATE_DELIVERY_PROOF=arteva_order_delivered
# WHATSAPP_TEMPLATE_OWNER_NEW_ORDER=arteva_owner_new_order
# WHATSAPP_TEMPLATE_INBOUND_FORWARD=arteva_customer_message
# WHATSAPP_TEMPLATE_WELCOME=arteva_welcome
# WHATSAPP_TEMPLATE_REFUND_RETURN=arteva_return_received
#
# Each also takes a _LANG suffix, falling back to WHATSAPP_TEMPLATE_LANG.
# WHATSAPP_TEMPLATE_LANG=en

# ── Gemini (AI chat assistant) ──
# Model. Names change as Google retires versions, so this is configuration
# rather than code — a retirement is then an env change, not a deploy. Ask the
# API what your key accepts:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY"
# The 2.5-and-newer models are "thinking" models: they spend part of the output
# budget on reasoning before answering, which is why the two settings below
# matter. gemini-flash-latest auto-follows the newest Flash, at the cost of the
# model changing under you without notice.
GEMINI_MODEL=gemini-3.6-flash
# Must cover the reasoning AND the reply. The original 250 was consumed almost
# entirely by reasoning, so customers received sentences cut off mid-word.
GEMINI_MAX_OUTPUT_TOKENS=2048
# 0 asks for no reasoning at all. A model with a floor (2.5 Pro) clamps up to
# its minimum; a model that predates the field ignores it. A reply about stock
# and opening hours does not need deliberation, and it is latency either way.
GEMINI_THINKING_BUDGET=0
GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────
# WhatsApp provider
# ─────────────────────────────────────────────────────────────
# 'meta'   = Meta Cloud API direct (default; needs Business Manager setup)
# 'twilio' = Twilio. Its Sandbox sends immediately with no number
#            registration, so conversations can run while the production
#            number is still being arranged.
WHATSAPP_PROVIDER=meta

# ── Twilio (only when WHATSAPP_PROVIDER=twilio) ──
# Console dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender is +14155238886. Swap for your own number once approved.
TWILIO_WHATSAPP_FROM=+14155238886
# Only set if the signed URL differs from what the server sees (proxies,
# custom domains). Must match the Twilio console byte for byte.
TWILIO_WEBHOOK_URL=

# Twilio identifies templates by Content SID (HX…), not by name — so on Twilio
# these WHATSAPP_TEMPLATE_* values hold SIDs from Content Template Builder.
# WHATSAPP_TEMPLATE_CUSTOMER_NEW_ORDER=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Number customers are sent to from the site and from receipt QR codes.
# Set this to the WhatsApp API number so inbound reaches the bot.
WHATSAPP_CONTACT_NUMBER=
