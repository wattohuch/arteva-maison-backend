# ============================================
# ARTÉVA Maison — backend environment
#
# Copy to `.env` and fill in real values.
# IMPORTANT: save this file as UTF-8 without a BOM. A UTF-16 fragment was once
# appended to the live .env, which silently broke every variable after that
# point (dotenv reads the file as UTF-8, so the keys parsed as garbage).
# ============================================

PORT=5000
NODE_ENV=production

# ── Database ──
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/arteva

# ── URLs ──
# FRONTEND_URL is used to build payment return links, so it must be the origin
# serving the React SPA (no trailing slash).
FRONTEND_URL=https://www.artevamaisonkw.com
BACKEND_URL=https://arteva-maison-backend-gy1x.onrender.com

# ── Auth ──
# One secret signs everything: access tokens, refresh tokens, the revenue
# unlock and the revenue reset ticket. Rotating it signs everybody out, which
# is the intended emergency lever.
JWT_SECRET=generate-a-long-random-string

# How long an ACCESS token lasts. Deliberately short — an expired one is
# renewed silently from the refresh token, so a low value here costs the user
# nothing and limits how long a leaked token is useful. Do not raise this to
# "fix" unexpected logouts; that hides the cause and widens the exposure.
JWT_ACCESS_EXPIRES_IN=2h

# How long a REFRESH token — and so a signed-in session — can live before the
# user has to enter their password again. Refresh tokens are stored hashed on
# the user record and rotate on every use, so this is revocable at any time.
JWT_REFRESH_EXPIRES_DAYS=30

# Superseded by the two settings above. Left documented because tokens minted
# under it are still accepted until they expire; it is no longer read.
# JWT_EXPIRES_IN=30d

# ── MyFatoorah (KNET, cards, Apple Pay) ──
# Dashboard → Integration → API Key. This is a JWT: several hundred characters.
# Anything shorter than 40 chars is treated as unconfigured, and checkout will
# fall back to cash on delivery with PAYMENT_GATEWAY_UNAVAILABLE.
MYFATOORAH_API_KEY=
MYFATOORAH_MODE=test          # test | live
MYFATOORAH_TIMEOUT_MS=15000

# ── Deema BNPL (separate credentials) ──
DEEMA_API_KEY=
DEEMA_WIDGET_KEY=
DEEMA_MODE=test               # test | live

# ── Email (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=ARTEVA Maison <orders@artevamaisonkw.com>

# Where mail addressed to "the owner" goes. Both are optional: with neither
# set, the address on the account holding the `owner` role is used, so changing
# the owner's email in the dashboard is enough to redirect it.
#   OWNER_EMAIL   — overrides the owner lookup everywhere (staging, shared inbox)
#   CONTACT_EMAIL — contact-form messages only, if they should not go to the owner
OWNER_EMAIL=
CONTACT_EMAIL=

# ── Cloudinary (product imagery) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Receipt printer ──
PRINTER_IPP_URL=

# ── WhatsApp Cloud API ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v18.0
WHATSAPP_OWNER_PHONE=96500000000,96500000001

# ── Gemini (AI chat assistant) ──
GEMINI_API_KEY=
