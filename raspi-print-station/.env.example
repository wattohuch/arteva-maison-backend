# ═══════════════════════════════════════════════════════════════
# ARTÉVA MAISON — Raspberry Pi Print + WhatsApp Station
#
# Copy to `.env` on the Pi and fill in:   cp .env.example .env
#
# Every variable below is one this code actually reads. (The old
# print-station.env.example in the backend root described a completely
# different Socket.io/thermal-printer design and none of its names matched
# anything here — ignore it.)
#
# Save as UTF-8 without a BOM and with Unix line endings.
# ═══════════════════════════════════════════════════════════════

# ── Backend connection (both services) ──────────────────────────
API_URL=https://arteva-maison-backend-gy1x.onrender.com

# Shared secret for the agent endpoints. MUST match PRINT_AGENT_KEY on the
# server. The committed default ('arteva-print-2026') is public — anyone who
# has seen the repo can read customer names, phones and addresses out of
# /api/admin/print-queue/poll with it. Set a real random value on BOTH sides.
PRINT_KEY=change-me-to-a-long-random-secret


# ═══════════════════════════════════════════════════════════════
# PRINT STATION  (print-station.js, health on :3100)
# ═══════════════════════════════════════════════════════════════

# CUPS queue name. Leave blank to auto-detect. Find it with: lpstat -p -d
PRINTER_NAME=

PAPER_SIZE=A4
POLL_SECONDS=30
PRINT_RECEIPT=true
PRINT_LABEL=false
HEALTH_PORT=3100

# Per-job retry cap before a job is moved to queue/failed/
MAX_RETRIES=5

# Force GC above this heap size (MB)
MAX_HEAP_MB=200

# Reject absurdly large order payloads (bytes)
PAYLOAD_MAX_BYTES=512000

# Kill a single print job that runs longer than this (ms)
PRINT_TIMEOUT_MS=120000

# How long to let Google-hosted webfonts load before printing anyway (ms).
# Receipts must print with the internet down, so this is a ceiling, not a
# requirement — offline, the locally installed Noto fonts are used instead.
FONT_WAIT_MS=4000

# How many 5s attempts a job waits for an offline printer before going back
# to the queue (12 = ~1 minute). The printer health check flushes the queue
# automatically when the printer reappears.
PRINTER_WAIT_ATTEMPTS=12

# Warn and stop accepting work below this much free disk (MB)
MIN_FREE_DISK_MB=50

# Full path to Chromium, if it is not in one of the usual places. Leave blank
# to auto-detect (/usr/bin/chromium, /usr/bin/chromium-browser, …).
CHROMIUM_PATH=

# Fetch the website's exact fonts (Cormorant Garamond / Montserrat) from Google
# when rendering receipts. OFF by default and that is deliberate: a stylesheet
# in <head> blocks rendering until it resolves, and on a Pi with no internet the
# request hangs rather than failing fast — which meant receipts did not print at
# all. Off, receipts render instantly from locally installed fonts (Arabic via
# Noto). Only turn this on if this Pi has reliable internet and you want exact
# typeface parity with the website.
RECEIPT_WEB_FONTS=false

# Print one fake receipt and exit — use `npm run test-print` instead
TEST_MODE=false


# ═══════════════════════════════════════════════════════════════
# WHATSAPP AGENT  (whatsapp-agent.js, health on :3101)
# ═══════════════════════════════════════════════════════════════

WA_POLL_INTERVAL=10000
WA_MAX_RETRIES=3
WA_SEND_DELAY=3000
WA_HEALTH_PORT=3101

# Give up on a message after this many total attempts across all restarts
WA_MAX_ATTEMPTS=10

# How many recently-sent messages to keep in memory so they can be re-sent
# automatically when a recipient reports it could not decrypt one.
#
# This is what makes "Waiting for this message" self-heal instead of being
# permanent: the recipient's phone asks us to re-send, and we can only oblige if
# the original is still here. Held in memory only (message bodies contain
# customer details, and retry requests arrive within seconds).
WA_SENT_STORE_MAX=300

# Quiet period after connecting before anything is sent (ms).
# Sending into a session that has not settled produces messages the recipient
# cannot decrypt — they see "Waiting for this message. This may take a while."
# Do not lower this without a good reason.
WA_WARMUP_MS=8000

# ── Customer auto-greeting: OFF by default, deliberately ──
# When a customer messages the business number, reply once with the bilingual
# acknowledgement.
#
# Leave this false until you have run `npm run wa:test -- <your-number>` and
# SEEN a readable message arrive. A WhatsApp session with corrupted encryption
# keys still reports every send as successful while the recipient sees only
# "Waiting for this message" — sending that to customers is worse than sending
# nothing at all.
WA_AUTO_GREET=false

# Forward each incoming customer message to the owner numbers below.
# Internal, so it defaults on.
WA_FORWARD_TO_ADMIN=true

# Owner/admin numbers, comma-separated, country code first, digits only.
# These are skipped by the greeting logic and receive forwarded messages.
ADMIN_PHONES=96565611566,96551008567


# ═══════════════════════════════════════════════════════════════
# OPTIONAL
# ═══════════════════════════════════════════════════════════════

# Both health endpoints listen on 0.0.0.0, so anything on the LAN can read
# them (printer name, order counts, memory, CPU temperature). Set a token to
# require ?token=… or an X-Health-Token header.
HEALTH_TOKEN=


# Fallback number of copies, used only for orders created before the server
# started sending a per-order count (Order.printCopies).
#
# The server decides this now: a receipt written at the counter comes through
# as 2 — one for the customer, one the shop keeps — and an online order as 1.
# Change RECEIPT_PRINT_COPIES in the BACKEND environment to alter that, not
# this value.
PRINT_COPIES=1
